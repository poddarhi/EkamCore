localhost {
  handle /api/* {
    reverse_proxy ekamcore-api:8420
  }
  handle /health {
    reverse_proxy ekamcore-api:8420
  }
  handle /paperless/* {
    uri strip_prefix /paperless
    reverse_proxy ekamcore-paperless:8000
  }
  handle {
    reverse_proxy ekamcore-web:3000
  }
  log {
    output file /data/access.log {
      roll_size 50MiB
      roll_keep 5
    }
    format json
  }
}
