{
  "name": "ekamcore",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for EkamCore, a private local life assistant.",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "dev:manager": "pnpm --filter @ekamcore/manager-app tauri:dev",
    "dev:mobile": "pnpm --filter @ekamcore/mobile dev",
    "generate:shared-types": "pnpm --filter @ekamcore/shared-types generate",
    "runtime:start": "./infra/runtime/start.sh",
    "runtime:stop": "./infra/runtime/stop.sh"
  }
}
