{
  "name": "ekamcore",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for EkamCore, a private local life assistant.",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "dev:backend": "apps/backend/.venv/bin/python -m uvicorn app.main:app --reload --app-dir apps/backend",
    "dev:manager": "pnpm --filter @ekamcore/manager-app tauri:dev",
    "dev:mobile": "pnpm --filter @ekamcore/mobile dev",
    "lint:api": "pnpm exec redocly lint --config .redocly.yaml docs/contracts/ekamcore-api.yaml",
    "validate:api": "pnpm run lint:api",
    "generate:shared-types": "pnpm --filter @ekamcore/shared-types generate",
    "build:shared-types": "pnpm --filter @ekamcore/shared-types build",
    "runtime:start": "./infra/runtime/start.sh",
    "runtime:stop": "./infra/runtime/stop.sh"
  },
  "devDependencies": {
    "@redocly/cli": "^2.21.1"
  }
}
