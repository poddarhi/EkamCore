# EkamCore Environment Variables
# Copy to .env: cp .env.example .env

# PostgreSQL
POSTGRES_USER=ekamcore
POSTGRES_PASSWORD=ekamcore_dev_password
POSTGRES_DB=ekamcore
DATABASE_URL=postgresql+asyncpg://ekamcore:ekamcore_dev_password@ekamcore-postgres:5432/ekamcore

# Redis
REDIS_PASSWORD=ekamcore_redis_dev
REDIS_URL=redis://:ekamcore_redis_dev@ekamcore-redis:6379/0

# Qdrant
QDRANT_API_KEY=ekamcore_qdrant_dev
QDRANT_URL=http://ekamcore-qdrant:6333

# Ollama (native on host — not in Docker)
OLLAMA_URL=http://host.docker.internal:11434

# JWT
JWT_SECRET_KEY=ekamcore-dev-jwt-secret-change-in-production
JWT_ALGORITHM=RS256

# API
API_HOST=0.0.0.0
API_PORT=8420
ENVIRONMENT=development
LOG_LEVEL=INFO

# Caddy
CADDY_DOMAIN=localhost

# PaperlessNGX
PAPERLESS_SECRET_KEY=ekamcore_paperless_dev_secret
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=ekamcore_dev_password
EKAMCORE_CONSUME_DIR=./consume
